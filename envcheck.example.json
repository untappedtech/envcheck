{
  "$schema": "./envcheck.schema.json",
  "Name": "Example Development Environment",
  "Software": [
    {
      "Name": "Git",
      "Command": "git",
      "PackageId": "Git.Git",
      "Required": false
    },
    {
      "Name": "Node.js",
      "Command": "node",
      "Version": "18.x",
      "PackageId": "OpenJS.NodeJS.18",
      "Required": false
    },
    {
      "Name": "WSL 2",
      "Command": "wsl",
      "VersionArguments": [
        "--status"
      ],
      "VersionPattern": "Default Version:\\s*(?<version>\\d+)",
      "Version": "2",
      "Required": false
    },
    {
      "Name": "Go",
      "Command": "go",
      "VersionArguments": [
        "version"
      ],
      "Version": "1.27.x",
      "PackageId": "GoLang.Go",
      "Required": false
    },
    {
      "Name": "PHP",
      "Path": "C:\\tools\\php\\php.exe",
      "Version": "8.2.x",
      "Required": false
    },
    {
      "Name": "MySQL",
      "Service": "MySQL",
      "Version": "8.4.x",
      "Required": false,
      "MustBeRunning": true
    },
    {
      "Name": "PowerToys",
      "PackageId": "Microsoft.PowerToys",
      "Required": false
    }
  ],
  "Environment": [
    {
      "Name": "APP_ENV",
      "Required": false,
      "Secret": false
    },
    {
      "Name": "API_TOKEN",
      "Required": false,
      "Secret": true
    }
  ],
  "Files": [
    {
      "Name": "Environment configuration",
      "Path": ".env",
      "Required": false
    },
    {
      "Name": "Composer configuration",
      "Path": "composer.json",
      "Required": false
    }
  ],
  "Connectivity": [
    {
      "Name": "Local database",
      "Host": "localhost",
      "Port": 3306,
      "TimeoutMs": 3000,
      "Required": false
    }
  ]
}